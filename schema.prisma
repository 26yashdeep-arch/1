generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum KycStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum CompanyType {
  MANUFACTURER_EXPORTER
  MERCHANT_TRADER
  BUYER
}

enum Incoterm {
  EXW
  FOB
  CFR
  CIF
  DDP
}

enum RfqStage {
  INQUIRY
  VALIDATED_RFQ
  NEGOTIATION
  NCNDA_SIGNED
  SAMPLE_INSPECTION
  ESCROW_LC_LOCK
  FULFILLMENT
}

enum VerificationType {
  GSTIN
  IEC
  UDYAM
  EORI_VIES
  UK_COMPANIES_HOUSE
  US_CBP
  SANCTIONS
}

enum AgreementType {
  NCND
  IMFPA
}

enum EscrowStatus {
  PENDING
  LOCKED
  RELEASED
  REFUNDED
  DISPUTED
}

model User {
  id             String          @id @default(cuid())
  email          String?         @unique
  phone          String?         @unique
  name           String?
  role           Role            @default(BUYER)
  kycStatus      KycStatus       @default(PENDING)
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id])
  rfqs           RFQ[]
  purchaseOrders PurchaseOrder[]
  agreements     Agreement[]
  audits         AuditTrail[]
  createdAt      DateTime        @default(now())
}

model Company {
  id              String            @id @default(cuid())
  legalName       String
  type            CompanyType
  country         String            @default("IN")
  gstin           String?           @unique
  iec             String?           @unique
  udyam           String?           @unique
  eori            String?
  domain          String?
  domainAgeDays   Int?
  factoryVerified Boolean           @default(false)
  riskScore       Int?
  users           User[]
  products        Product[]
  supplied        PurchaseOrder[]
  verifications   VerificationLog[]
  createdAt       DateTime          @default(now())
}

model Product {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  hsCode     String
  incoterm   Incoterm @default(FOB)
  moq        Int      @default(1)
  priceTiers Json
  rfqs       RFQ[]
  createdAt  DateTime @default(now())

  @@index([hsCode])
}

model RFQ {
  id              String          @id @default(cuid())
  buyerId         String
  buyer           User            @relation(fields: [buyerId], references: [id])
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id])
  hsCode          String
  weightKg        Decimal         @db.Decimal(12, 2)
  destinationPort String
  stage           RfqStage        @default(INQUIRY)
  landedCostUsd   Decimal?        @db.Decimal(14, 2)
  orders          PurchaseOrder[]
  agreements      Agreement[]
  createdAt       DateTime        @default(now())

  @@index([stage])
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  rfqId      String
  rfq        RFQ                 @relation(fields: [rfqId], references: [id])
  buyerId    String
  buyer      User                @relation(fields: [buyerId], references: [id])
  supplierId String
  supplier   Company             @relation(fields: [supplierId], references: [id])
  piNumber   String              @unique
  icpoRef    String?
  totalUsd   Decimal             @db.Decimal(14, 2)
  incoterm   Incoterm
  escrow     EscrowTransaction[]
  createdAt  DateTime            @default(now())
}

model VerificationLog {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  type      VerificationType
  status    String
  score     Int?
  payload   Json
  createdAt DateTime         @default(now())

  @@index([companyId, type])
}

model Agreement {
  id                 String        @id @default(cuid())
  type               AgreementType
  signerId           String
  signer             User          @relation(fields: [signerId], references: [id])
  rfqId              String?
  rfq                RFQ?          @relation(fields: [rfqId], references: [id])
  documentSha256     String
  sha256             String
  signatureDataUrl   String        @db.Text
  signerIp           String
  signedAt           DateTime      @default(now())
  pdfUrl             String?
}

model EscrowTransaction {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  amountUsd       Decimal       @db.Decimal(14, 2)
  status          EscrowStatus  @default(PENDING)
  lockedAt        DateTime?
  releasedAt      DateTime?
  createdAt       DateTime      @default(now())
}

model AuditTrail {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
